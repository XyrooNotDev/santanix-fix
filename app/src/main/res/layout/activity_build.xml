<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#08090D" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="18dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="SANTANIC BUILD" android:textColor="#FF2945" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="5dp" android:text="Build Flutter" android:textColor="#FFFFFF"
            android:textSize="25sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:orientation="vertical" android:padding="16dp"
            android:background="@drawable/bg_panel">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Repository GitHub" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="16sp" />
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="14dp" android:hint="Username GitHub"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etOwner"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="Nama Repository"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etRepo"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="Workflow YAML (contoh: build.yml)"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etWorkflow"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="18dp" android:text="File Project (ZIP / source / YAML)"
                android:textColor="#FFFFFF" android:textStyle="bold" />
            <Button android:id="@+id/btnPickFiles" android:layout_width="match_parent"
                android:layout_height="52dp" android:layout_marginTop="10dp" android:backgroundTint="#282B36"
                android:text="＋  Pilih File Project" android:textAllCaps="false" android:textColor="#FFFFFF" />
            <TextView android:id="@+id/tvFileCount" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="0 file dipilih" android:textColor="#A9ABB5" android:textSize="12sp" />
            <Button android:id="@+id/btnStartBuild" android:layout_width="match_parent"
                android:layout_height="56dp" android:layout_marginTop="22dp"
                android:backgroundTint="#EF1733" android:text="↑  Upload &amp; Mulai Build"
                android:textAllCaps="false" android:textColor="#FFFFFF" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:padding="14dp" android:background="@drawable/bg_panel"
            android:text="Pastikan repository memiliki branch main dan workflow GitHub Actions yang sesuai."
            android:textColor="#A9ABB5" android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
