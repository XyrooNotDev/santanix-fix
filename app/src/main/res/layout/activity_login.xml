<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#08090D" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp" android:gravity="center_horizontal">
        <ImageView android:layout_width="142dp" android:layout_height="142dp"
            android:layout_marginTop="30dp" android:src="@drawable/logo_santanic"
            android:scaleType="fitCenter" android:contentDescription="Santanic Build logo" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="SANTANIC" android:textColor="#FFFFFF"
            android:textSize="29sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="BUILD" android:textColor="#FF233D" android:textSize="29sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:layout_marginBottom="28dp"
            android:gravity="center" android:text="Build APK Android Otomatis\ndengan GitHub Actions"
            android:textColor="#C3C5CE" android:textSize="14sp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="18dp"
            android:background="@drawable/bg_panel">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Login GitHub" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="Hubungkan akun GitHub untuk mengunggah project dan menjalankan workflow build."
                android:textColor="#A9ABB5" android:textSize="13sp" />
            <Button android:id="@+id/btnLoginGithub" android:layout_width="match_parent"
                android:layout_height="54dp" android:layout_marginTop="20dp"
                android:backgroundTint="#EF1733" android:text="Login dengan GitHub"
                android:textAllCaps="false" android:textColor="#FFFFFF" android:textStyle="bold" />
            <TextView android:id="@+id/tvDeviceCode" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="18dp"
                android:gravity="center" android:textColor="#FF5268" android:textSize="16sp"
                android:textStyle="bold" android:fontFamily="monospace" />
            <TextView android:id="@+id/tvStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:gravity="center" android:textColor="#D0D2DA" android:textSize="12sp" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" android:gravity="center"
            android:text="Session login disimpan di perangkat\nAutentikasi menggunakan GitHub Device Flow"
            android:textColor="#7F8491" android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
